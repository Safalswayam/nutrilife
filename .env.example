# ============================================================
# NutriLife – Environment Variables Reference
# Copy this file to:
#   Backend  → api/.env       (loaded by python-dotenv)
#   Frontend → .env.local     (loaded by Next.js)
# ============================================================

# ─── Backend (api/.env) ──────────────────────────────────────

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=nutrilife_db

# OpenRouter (preferred). Backend also accepts OPENAI_API_KEY for backward compatibility.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Google OAuth
# https://console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxx

# Razorpay
# https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret
# Dashboard → Settings → Webhooks → Secret
# Webhook URL: https://yourapi.com/api/webhook/razorpay
# Subscribe to: subscription.activated, subscription.charged,
#               subscription.cancelled, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Email verification for direct email/password sign up
# Preferred: API-based providers like Resend or Brevo.
# Fallback: Gmail SMTP with an App Password, not your normal Gmail password.
# If no provider is configured, local development can fall back to printing the code in the API terminal.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_FROM_NAME=NutriLife
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_API_TIMEOUT_SECONDS=20
ALLOW_CONSOLE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ─── Frontend (.env.local) ───────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Razorpay public key only – NEVER expose KEY_SECRET to frontend
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# ── Telegram Admin Notifications ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=@NUTRILIFEDIET
