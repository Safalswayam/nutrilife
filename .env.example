# ============================================================
# NutriLife – Environment Variables Reference
# Copy this file to:
#   Backend  → api/.env       (loaded by python-dotenv)
#   Frontend → .env.local     (loaded by Next.js)
# ============================================================

# ─── Backend (api/.env) ──────────────────────────────────────

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=nutrilife_db

# OpenRouter (preferred). Backend also accepts OPENAI_API_KEY for backward compatibility.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Google OAuth
# https://console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxx

# Razorpay
# https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret
# Dashboard → Settings → Webhooks → Secret
# Webhook URL: https://yourapi.com/api/webhook/razorpay
# Subscribe to: subscription.activated, subscription.charged,
#               subscription.cancelled, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Frontend (.env.local) ───────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Razorpay public key only – NEVER expose KEY_SECRET to frontend
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# ── Telegram Admin Notifications ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=@NUTRILIFEDIET
